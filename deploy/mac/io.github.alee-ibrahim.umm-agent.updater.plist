<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchDaemon for the use-my-mac agent updater. Runs as root (no UserName)
  at boot and every 15 minutes (plus up to 2 minutes of random jitter): asks
  the router which version to run, verifies the signed release, swaps the
  binary, restarts the agent and rolls back if it does not heartbeat.
  No UI, no notifications. Log: /usr/local/var/log/umm-updater.log
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>io.github.alee-ibrahim.umm-agent.updater</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/umm-agent</string>
    <string>update</string>
    <string>-config</string>
    <string>/usr/local/etc/umm/agent.yaml</string>
    <string>-label</string>
    <string>io.github.alee-ibrahim.umm-agent</string>
    <string>-jitter</string>
    <string>2m</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/usr/local/var/log/umm-updater.log</string>
  <key>StandardErrorPath</key>
  <string>/usr/local/var/log/umm-updater.log</string>
</dict>
</plist>
